# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados
MONGODB_URI=mongodb://localhost:27017/task-manager

# Autenticação
# Gere um segredo próprio: openssl rand -base64 32
JWT_SECRET=troque-este-valor-por-um-segredo-gerado-localmente
# Sempre com unidade (8h, 30m, 7d): sem unidade, o valor é lido em milissegundos
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
