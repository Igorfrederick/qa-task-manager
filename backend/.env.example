# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados
MONGODB_URI=mongodb://localhost:27017/task-manager

# Autenticação
# Gere um segredo próprio: openssl rand -base64 32
JWT_SECRET=troque-este-valor-por-um-segredo-gerado-localmente
# Sempre com unidade (8h, 30m, 7d): sem unidade, o valor é lido em milissegundos
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Seed (npm run seed) — senhas dos usuários fictícios: a do lead e a comum aos
# dois qa. Têm de ser iguais a E2E_LEAD_PASSWORD e E2E_QA_PASSWORD em e2e/.env
SEED_LEAD_PASSWORD=troque-este-valor
SEED_QA_PASSWORD=troque-este-valor
